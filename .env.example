# Copy to .env (git-ignored) and change the secrets. Never commit .env.
# Keep POSTGRES_PASSWORD URL-safe (letters, digits, - _ .) because it is embedded in DATABASE_URL.

POSTGRES_DB=thermotrace
POSTGRES_USER=thermotrace
POSTGRES_PASSWORD=change-me-please
DB_PORT=5433

API_PORT=8000
WEB_PORT=8080
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
# Enables POST /api/admin/sync/trigger (header X-Admin-Token). Leave empty to disable the endpoint.
ADMIN_TOKEN=

# ── OpenStreetMap sync ───────────────────────────────────────────────────────
# Geofabrik region path. Baseline = <base>/<region>-latest.osm.pbf,
# updates = <base>/<region>-updates (daily diffs published by Geofabrik).
OSM_REGION=asia/india/north-eastern-zone
# Override only to use a different compatible replication server:
OSM_REPLICATION_URL=
# Human description of how often the chosen replication server publishes:
OSM_SOURCE_CADENCE=daily (Geofabrik extract diffs)
# How often the worker asks the server for new diffs (state.txt is a tiny file).
OSM_POLL_INTERVAL_SECONDS=300
# Data older than this makes the source "delayed". 129600 s = 36 h suits a daily source.
OSM_FRESHNESS_TARGET_SECONDS=129600
OSM_CACHE_MB=1024

# Retry/backoff and HTTP timeouts for the worker
SYNC_RETRY_BASE_SECONDS=30
SYNC_RETRY_MAX_SECONDS=3600
SYNC_HTTP_TIMEOUT_SECONDS=30
# Safety stop: refuse a sync that would deactivate more than this share of active sites.
SYNC_MAX_DEACTIVATE_FRACTION=0.2

# ── NASA FIRMS thermal sources ───────────────────────────────────────────────
# Optional free MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/). Without it the public
# regional 7-day CSV files are used (same VIIRS data, no key needed).
FIRMS_MAP_KEY=
THERMAL_INTERVAL_SECONDS=600
THERMAL_WINDOW_DAYS=14

# ── Alerting (Phase 6). Every channel is optional; leave a channel's variables empty to disable it. ──
# Analyst decisions (Confirm / Reject / Unsure) are only accepted with this token; empty = decisions disabled.
ANALYST_TOKEN=
# Alert rule: P(industrial fire) threshold, or facility power z-score vs its own baseline; only sources seen in the last N hours.
ALERT_P_FIRE_THRESHOLD=0.6
ALERT_FRP_Z_THRESHOLD=3
ALERT_MAX_AGE_HOURS=24
ALERT_DEDUPE_HOURS=6
ALERT_MAX_PER_CYCLE=10
# Telegram bot (create one with @BotFather, send it a message, read chat_id from getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook (JSON POST; X-ThermoTrace-Signature = sha256 HMAC of the body when a secret is set)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# Email over SMTP (SMTP_SECURITY: starttls | ssl | none)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Dashboard address put into messages (optional)
ALERT_BASE_URL=

# ── Security and operations (Phase 9, docs/SECURITY.md, docs/OFFLINE.md) ─────────────────────────────────────────────────────
# off = open reading + legacy tokens (development, public demo) | local = accounts + sessions | proxy = identity from an OIDC proxy
AUTH_MODE=off
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# proxy mode only: shared secret between the OIDC proxy and the API, and the group -> role mapping
AUTH_PROXY_SECRET=
AUTH_PROXY_ADMIN_GROUP=thermotrace-admin
AUTH_PROXY_ANALYST_GROUP=thermotrace-analyst
# behind caddy -> nginx -> api use 2 so the logged client address cannot be forged with X-Forwarded-For
TRUSTED_PROXY_HOPS=0
RATE_LIMIT=true
RATE_GENERAL_PER_MIN=600
RATE_HEAVY_PER_MIN=12
RATE_LOGIN_PER_MIN=10
# offline mode (with docker-compose.offline.yml): no outbound connection except FIRMS; hosts can be added with OFFLINE_ALLOW_HOSTS
OFFLINE_MODE=false
# backups (python deploy/pg_backup.py backup --passphrase-env BACKUP_PASSPHRASE): keep this value somewhere else too
BACKUP_PASSPHRASE=
