# ─────────────────────────────────────────────────────────────────────────────
# India Industrial Intelligence Platform — Frontend environment variables
# Copy this file to .env.local (git-ignored) and adjust as needed.
# ─────────────────────────────────────────────────────────────────────────────

# ── API base URL ──────────────────────────────────────────────────────────────
# Defaults to '/api' which is proxied to http://localhost:8000 by Vite
# (see vite.config.ts proxy). Only set this explicitly if you want to bypass
# the Vite proxy — e.g., when deploying the frontend separately from the API.
#
# Development with Vite proxy (default — no change needed):
# VITE_API_BASE_URL=/api
#
# Development hitting the backend directly (disables proxy):
# VITE_API_BASE_URL=http://localhost:8000/api
#
# Production (point to your deployed backend):
# VITE_API_BASE_URL=https://api.your-domain.com/api
