# ─────────────────────────────────────────────────────────────────────────────
# India Industrial Intelligence Platform — Backend environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored; this example file is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data mode ──────────────────────────────────────────────────────────────────
# synthetic : in-memory demo dataset (default, no database required)
# postgis   : live queries against industrial_sites PostGIS table
DATA_MODE=synthetic

# ── Database (required only when DATA_MODE=postgis) ───────────────────────────
# Use the same database that industrial-data pipeline writes to.
# psycopg2 driver (sync, well-supported):
DATABASE_URL=postgresql+psycopg2://industrial:industrial@localhost:5432/industrial_data

# psycopg v3 driver (async-capable, faster):
# DATABASE_URL=postgresql+psycopg://industrial:industrial@localhost:5432/industrial_data

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for browser cross-origin requests.
# Defaults to ["*"] (permissive) when this variable is unset.
# In production, restrict to your actual frontend domain(s):
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
